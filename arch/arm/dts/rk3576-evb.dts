/dts-v1/;
#include "rk3576.dtsi"
#include "rk3576-u-boot.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/pwm/pwm.h>

/ {
	model = "Rockchip RK3576 100ASK DshanPi A1 Board";
	compatible = "rockchip,rk3576-evb", "rockchip,rk3576";

	fan: pwm-fan {
		u-boot,dm-pre-reloc;
		compatible = "pwm-fan";
		pwms = <&pwm1_6ch_0 0 50000 PWM_POLARITY_INVERTED>;
		status = "okay";
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		u-boot,dm-pre-reloc;
		status = "okay";

		volumeup-key {
			u-boot,dm-pre-reloc;
			linux,code = <KEY_VOLUMEUP>;
			label = "volume up";
			press-threshold-microvolt = <1750>;
		};
	};
};

/* DShanPi A1 fan control on GPIO0_B4. */
&pwm1_6ch_0 {
	u-boot,dm-pre-reloc;
	pinctrl-0 = <&pwm1m0_ch0>;
	status = "okay";
};

&pwm1m0_ch0 {
	u-boot,dm-pre-reloc;
};

&gmac0 {
	/* Use rgmii-rxid mode to disable rx delay inside Soc */
	phy-mode = "rgmii-rxid";
	clock_in_out = "output";

	snps,reset-gpio = <&gpio0 RK_PC2 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&eth0m0_miim
		     &eth0m0_tx_bus2
		     &eth0m0_txctl
		     &eth0m0_rx_bus2
		     &eth0m0_rxctl
		     &eth0m0_rgmii_clk
		     &eth0m0_rgmii_bus>;

	tx_delay = <0x1b>;

	phy-handle = <&rgmii_phy0>;
	status = "okay";
};

&mdio0 {
	rgmii_phy0: phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		u-boot,dm-pre-reloc;
		reg = <0x0>;
	};
};


&sdgmac_grf {
	u-boot,dm-pre-reloc;
	status = "okay";
};


&gmac0 {
	u-boot,dm-pre-reloc;
};

&gmac0_stmmac_axi_setup {
	u-boot,dm-pre-reloc;
};

&gmac0_mtl_rx_setup {
	u-boot,dm-pre-reloc;

	queue0 {
		u-boot,dm-pre-reloc;
	};
};

&gmac0_mtl_tx_setup {
	u-boot,dm-pre-reloc;

	queue0 {
		u-boot,dm-pre-reloc;
	};
};

&mdio0 {
	u-boot,dm-pre-reloc;
};

&eth0m0_miim {
	u-boot,dm-pre-reloc;
};

&eth0m0_tx_bus2 {
	u-boot,dm-pre-reloc;
};

&eth0m0_rx_bus2 {
	u-boot,dm-pre-reloc;
};

&eth0m0_txctl {
	u-boot,dm-pre-reloc;
};

&eth0m0_rxctl {
	u-boot,dm-pre-reloc;
};

&eth0m0_rgmii_clk {
	u-boot,dm-pre-reloc;
};

&eth0m0_rgmii_bus {
	u-boot,dm-pre-reloc;
};



